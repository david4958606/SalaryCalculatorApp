<Window x:Class="SalaryCalculatorApp.MainWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:vm="clr-namespace:SalaryCalculatorApp.ViewModels"
         Title="工资计算器"
         Height="750"
         Width="1000"
         WindowStartupLocation="CenterScreen"
         Background="#F9F9F9"
         FontFamily="Microsoft YaHei UI">

    <Grid Margin="15">
        <TabControl>
            <!-- ───────────── 工资计算 ───────────── -->
            <TabItem Header="工资计算">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：基础参数输入 -->
                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,8,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="15">
                                <!-- 标题区域 -->
                                <Border Style="{StaticResource HeaderStyle}">
                                    <TextBlock Text="薪资参数" Style="{StaticResource TitleBlockStyle}" />
                                </Border>

                                <!-- 基础 & 绩效 -->
                                <TextBlock Text="基础工资：" Style="{StaticResource LabelBlockStyle}" />
                                <TextBox Text="{Binding BaseSalaryText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernTextBoxStyle}" />

                                <TextBlock Text="绩效工资：" Style="{StaticResource LabelBlockStyle}" />
                                <TextBox Text="{Binding PerformanceSalaryText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernTextBoxStyle}" />

                                <TextBlock Text="五险一金缴纳基数：" Style="{StaticResource LabelBlockStyle}" />
                                <TextBox Text="{Binding InsuranceBaseText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernTextBoxStyle}" />

                                <TextBlock Text="上月为止累计预扣预缴应纳税所得额：" Style="{StaticResource LabelBlockStyle}" />
                                <TextBox Text="{Binding GrandTotalPrePayTaxText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernTextBoxStyle}" />

                                <!-- 选项区域 -->
                                <Border Background="#F5F5F5" CornerRadius="4" Padding="12,8" Margin="0,0,0,15">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding IsProbation}"
                                                  Content="试用期（工资八折，无补贴）"
                                                  Style="{StaticResource CheckBoxStyle}" />

                                        <CheckBox IsChecked="{Binding FullMonth}"
                                                  Content="当月全勤"
                                                  Style="{StaticResource CheckBoxStyle}" />

                                        <CheckBox IsChecked="{Binding FullQuarter}"
                                                  IsEnabled="{Binding IsQuarterMonth}"
                                                  Content="上季度全勤"
                                                  ToolTip="仅 1、4、7、10 月允许勾选"
                                                  Style="{StaticResource CheckBoxStyle}" />

                                        <CheckBox IsChecked="{Binding GrandTotalEnabled}"
                                                  Content="累计计算税费"
                                                  Style="{StaticResource CheckBoxStyle}" Margin="0,0,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- 操作按钮 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                     <Button Content="计算工资" 
                                             Style="{StaticResource ButtonStyle}"
                                             Width="100" 
                                             Margin="0,0,10,0" 
                                             Command="{Binding CalculateCommand}" />

                                     <Button Content="导出 Excel" 
                                             Style="{StaticResource ButtonStyle}"
                                             Background="#4CAF50"
                                             Width="100" 
                                             Command="{Binding ExportExcelCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 右侧：日历 & 结果 -->
                    <Grid Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>

                        <!-- 标题 -->
                        <Border Grid.Row="0" Style="{StaticResource HeaderStyle}" Margin="0,0,0,5">
                            <TextBlock Text="工作日历" Style="{StaticResource TitleBlockStyle}" />
                        </Border>

                        <!-- 日历控件 -->
                        <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
                            <Calendar x:Name="WorkCalendar"
                                       SelectionMode="SingleDate"
                                       SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                       DisplayDate="{Binding DisplayMonth, Mode=TwoWay}"
                                       Background="White"
                                       FontFamily="Microsoft YaHei UI"
                                       GotMouseCapture="Calendar_GotMouseCapture"
                                       Height="Auto"
                                       Width="Auto">
                                <Calendar.Resources>
                                    <Style TargetType="CalendarDayButton">
                                        <Setter Property="Margin" Value="2" />
                                        <Setter Property="Cursor" Value="Hand" />
                                    </Style>
                                </Calendar.Resources>
                                <Calendar.LayoutTransform>
                                    <ScaleTransform ScaleX="2" ScaleY="2"/>
                                </Calendar.LayoutTransform>
                            </Calendar>
                        </Border>

                        <!-- 录入按钮 -->
                        <Button x:Name="CalendarButton"
                                Grid.Row="2"
                                Content="录入加班时长"
                                Margin="0,10,0,10"
                                Style="{StaticResource ButtonStyle}"
                                Command="{Binding EditSelectedDateCommand}" />

                        <!-- 结果显示 -->
                        <Border Grid.Row="3" Style="{StaticResource PanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" 
                                           Text="计算结果" 
                                           Background="#F0F0F0" 
                                           Padding="10,5" 
                                           FontWeight="SemiBold"/>

                                <TextBox Text="{Binding ResultText}"
                                          Grid.Row="1"
                                          IsReadOnly="True"
                                          TextWrapping="Wrap"
                                         Padding="10"
                                         FontFamily="Microsoft YaHei UI"
                                         Background="White"
                                         BorderThickness="0,1,0,0"
                                         BorderBrush="#E0E0E0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ───────────── 系数设置 ───────────── -->
            <TabItem Header="系数设置">
                <Border Style="{StaticResource PanelStyle}" Margin="0,15,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15">
                            <!-- 五险一金设置 -->
                            <Border Style="{StaticResource HeaderStyle}">
                                <TextBlock Text="五险一金缴纳比率" Style="{StaticResource TitleBlockStyle}" />
                            </Border>

                            <Grid Margin="0,0,0,15">
                                <Grid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource LabelBlockStyle}">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
                                        <Setter Property="Width" Value="80"/>
                                        <Setter Property="Margin" Value="5"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                    </Style>
                                </Grid.Resources>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 行 0 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="养老保险："/>
                                <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding PensionInsuranceRateText, UpdateSourceTrigger=LostFocus}"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="医疗保险："/>
                                <TextBox  Grid.Row="0" Grid.Column="3" Text="{Binding MedicalInsuranceRateText, UpdateSourceTrigger=LostFocus}"/>

                                <TextBlock Grid.Row="0" Grid.Column="4" Text="保险附加值："/>
                                <TextBox  Grid.Row="0" Grid.Column="5" Text="{Binding InsuranceAddonText, UpdateSourceTrigger=LostFocus}"/>

                                <!-- 行 1 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="失业保险："/>
                                <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding UnemploymentInsuranceRateText, UpdateSourceTrigger=LostFocus}"/>

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="工伤保险："/>
                                <TextBox  Grid.Row="1" Grid.Column="3" Text="{Binding WorkInjuryInsuranceRateText, UpdateSourceTrigger=LostFocus}"/>

                                <!-- 行 2 -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="生育保险："/>
                                <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding MaternityInsuranceRateText, UpdateSourceTrigger=LostFocus}"/>

                                <TextBlock Grid.Row="2" Grid.Column="2" Text="其他保险："/>
                                <TextBox  Grid.Row="2" Grid.Column="3" Text="{Binding OtherInsuranceRateText, UpdateSourceTrigger=LostFocus}"/>

                                <!-- 行 3 -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="公积金："/>
                                <TextBox  Grid.Row="3" Grid.Column="1" Text="{Binding HousingFundRateText, UpdateSourceTrigger=LostFocus}"/>

                                <TextBlock Grid.Row="3" Grid.Column="2" Text="企业年金："/>
                                <TextBox  Grid.Row="3" Grid.Column="3" Text="{Binding CorporatePensionRateText, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>

                            <!-- 各项补贴设置 -->
                            <Border Style="{StaticResource HeaderStyle}">
                                <TextBlock Text="各项补贴" Style="{StaticResource TitleBlockStyle}" />
                            </Border>

                            <Grid>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource LabelBlockStyle}">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
                                        <Setter Property="Width" Value="80"/>
                                        <Setter Property="Margin" Value="5"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                    </Style>
                                </Grid.Resources>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 行 0 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="交通补贴："/>
                                <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding TransportationSubsidyText, UpdateSourceTrigger=LostFocus}"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="其他补贴："/>
                                <TextBox  Grid.Row="0" Grid.Column="3" Text="{Binding OtherSubsidyText, UpdateSourceTrigger=LostFocus}"/>

                                <!-- 行 1 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="项目奖系数："/>
                                <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding ProjectBonusCoefficientText, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>

                            <Border Style="{StaticResource HeaderStyle}">
                                <TextBlock Text="专项附加扣除" Style="{StaticResource TitleBlockStyle}" />
                            </Border>

                            <Grid>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource LabelBlockStyle}">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
                                        <Setter Property="Width" Value="80"/>
                                        <Setter Property="Margin" Value="5"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                    </Style>
                                </Grid.Resources>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 行 0 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="专项附加扣除："/>
                                <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding SpecialAdditionalReductionText, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ───────────── 详细结果 ───────────── -->
            <TabItem Header="详细结果">
                <Grid Margin="0,15,0,0">
                    <Border Style="{StaticResource PanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource HeaderStyle}" Margin="0">
                                <TextBlock Text="工资明细表" Style="{StaticResource TitleBlockStyle}" />
                            </Border>

                            <DataGrid ItemsSource="{Binding DetailLines}"
                                       Grid.Row="1"
                                       AutoGenerateColumns="False" 
                                       IsReadOnly="True"
                                       Style="{StaticResource DataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="日期/项目" 
                                                        Binding="{Binding Label}" 
                                                        Width="4*" />
                                    <DataGridTextColumn Header="金额" 
                                                        Binding="{Binding Amount, StringFormat={}{0:F2}}" 
                                                        Width="6*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
